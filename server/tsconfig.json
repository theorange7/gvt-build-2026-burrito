{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@wrapped/shared": ["../shared/src/index.ts"],
      "@wrapped/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
