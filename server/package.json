{
  "name": "@wrapped/server",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build-shared.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "package": "pnpm build && node scripts/zip-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:test": "vitest run test/integration/wrap.test.ts",
    "ai:test:live": "INTEGRATION_LIVE=1 vitest run test/integration/wrap.test.ts"
  },
  "dependencies": {
    "@azure/ai-projects": "^1.0.0",
    "@azure/data-tables": "^13.3.0",
    "@azure/functions": "^4.5.1",
    "@azure/identity": "^4.5.0",
    "@azure/service-bus": "^7.9.5",
    "@wrapped/shared": "file:../shared",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "mammoth": "^1.12.0",
    "openai": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "msw": "^2.6.6",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
