# Copy to terraform.tfvars and fill in values before running terraform apply.
# Never commit terraform.tfvars — it is listed in .gitignore.

subscription_id     = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
resource_group_name = "rg-wrapped-backend"
location            = "eastus2"
location_short      = "eus2"
environment         = "prod"

# ── Secrets (also injectable via TF_VAR_* env vars in CI) ─────────────────────
wrap_jwt_secret   = "replace-with-a-random-32-plus-char-string"
anthropic_api_key = ""                     # set if using Anthropic provider

# Azure AI Foundry (leave empty to use Anthropic only)
azure_foundry_project_endpoint = ""
azure_foundry_api_version      = ""

# ── Capacity ──────────────────────────────────────────────────────────────────
wrap_max_concurrency              = 8
wrap_per_install_limit            = 1
wrap_result_ttl_hours             = 24
wrap_register_rate_limit_per_hour = 10

# ── Resource names ────────────────────────────────────────────────────────────
wrap_service_bus_queue_name = "wrap-jobs"
wrap_tables_jobs            = "wrapJobs"
wrap_tables_results         = "wrapResults"

# Comma-separated CORS origins — include your deployed Next.js URL
wrap_allowed_origins = "https://app.wrapped-for-work.example.com,tauri://localhost"
